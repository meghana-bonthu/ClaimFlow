{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "ClaimFlow": "Data Source=claimflow.db"
  },
  "Jwt": {
    "Issuer": "ClaimFlow",
    "Audience": "ClaimFlow.Web",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Adjudication": {
    "HighDollarReviewThreshold": 10000,
    "PendOutOfNetwork": true
  },
  "Seed": {
    "DemoUsers": true,
    "DemoClaims": true
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
